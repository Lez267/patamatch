{
  "name": "patamatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "local": "node scripts/local.mjs",
    "setup": "node scripts/local.mjs --setup-only",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "build:vercel": "prisma generate && node scripts/migrate.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "check": "tsc --noEmit",
    "verify:demo": "node scripts/verify-demo.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:cloud": "tsx prisma/seed.ts --cloud",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:reset-password": "bash scripts/reset-admin-password.sh",
    "test": "node --import tsx --test --experimental-test-isolation=none tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "better-auth": "^1.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.4.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.186.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
